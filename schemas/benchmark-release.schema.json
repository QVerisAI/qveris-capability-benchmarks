        "cap_id",
        "cap_version",
        "provider_id",
        "access_path_id",
        "method_version",
        "method_digest",
        "suite_fingerprint",
        "evidence_refs",
        "value",
        "scale_min",
        "scale_max",
        "unit",
        "direction"
      ],
      "title": "MetricScore",
      "type": "object"
    },
    "ReleaseFact": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "$ref": "#/$defs/MetricDetails",
          "propertyNames": {
            "not": {
              "anyOf": [
                {
                  "pattern": "[sS][cC][oO][rR][eE]"
                },
                {
                  "pattern": "[rR][aA][tT][iI][nN][gG]"
                },
                {
                  "pattern": "[rR][aA][nN][kK]"
                }
              ]
            }
          }
        },
        "dimension_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension Id"
        },
        "dimension_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/DimensionState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "fact_type": {
          "$ref": "#/$defs/ReleaseFactType"
        },
        "metric_ranking": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricRanking"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metric_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "fact_type"
      ],
      "title": "ReleaseFact",
      "type": "object"
    },
    "ReleaseFactType": {
      "enum": [
        "outcome",
        "evidence",
        "limitation",
        "access_path",
        "provider_feedback"
      ],
      "title": "ReleaseFactType",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "catalog_snapshot_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Catalog Snapshot Digest",
          "type": "string"
        },
        "contract_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Digest",
          "type": "string"
        },
        "contract_version": {
          "minimum": 1,
          "title": "Contract Version",
          "type": "integer"
        },
        "harbor_capability_id": {
          "minLength": 3,
          "pattern": "^[A-Z][A-Z0-9]*(?:\\.[A-Z][A-Z0-9_]*)+$",
          "title": "Harbor Capability Id",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        }
      },
      "required": [
        "source_type",
        "harbor_capability_id",
        "contract_version",
        "catalog_snapshot_digest",
        "contract_digest"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "harbor_catalog"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cap_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cap Id"
    },
    "cap_sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Cap Sources",
      "type": "array"
    },
    "cap_version": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cap Version"
    },
    "developer_selection_facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReleaseFact"
      },
      "title": "Developer Selection Facts",
      "type": "array"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "github_artifacts_manifest_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Github Artifacts Manifest Digest"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metric_definitions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MetricDefinition"
      },
      "title": "Metric Definitions",
      "type": "array"
    },
    "outcome_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Outcome Ids",
      "type": "array"
    },
    "provider_feedback_facts": {
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
          "items": {
            "$ref": "#/$defs/ReleaseFact"
          },
          "type": "array"
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Provider Feedback Facts",
      "type": "object"
    },
    "public_evidence_manifest_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Public Evidence Manifest Digest"
    },
    "release_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Release Id",
      "type": "string"
    },
    "run_plan_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Run Plan Digest",
      "type": "string"
    },
    "suite_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Suite Fingerprint",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "version",
    "suite_fingerprint",
    "run_plan_digest"
  ],
  "title": "BenchmarkRelease",
  "type": "object"
}
