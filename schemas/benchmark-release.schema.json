          "title": "Cap Version",
          "type": "string"
        },
        "cohort_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Cohort Digest",
          "type": "string"
        },
        "cohort_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Cohort Id",
          "type": "string"
        },
        "definition_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Definition Digest",
