        },
        "dimension_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Dimension Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ],
          "title": "Direction",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "method_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Method Digest",
          "type": "string"
        },
        "method_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Method Version",
          "type": "string"
        },
        "metric_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Metric Id",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Provider Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "rank_of": {
          "minimum": 1,
          "title": "Rank Of",
          "type": "integer"
        },
        "scale_max": {
          "title": "Scale Max",
          "type": "number"
        },
        "scale_min": {
          "title": "Scale Min",
          "type": "number"
        },
        "suite_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Suite Fingerprint",
          "type": "string"
        },
        "tie_method": {
          "enum": [
            "competition",
            "dense",
            "ordinal"
          ],
          "title": "Tie Method",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "definition_digest",
        "dimension_id",
        "cap_id",
        "cap_version",
        "provider_id",
        "access_path_id",
        "method_version",
        "method_digest",
        "suite_fingerprint",
        "evidence_refs",
        "cohort_id",
        "cohort_digest",
        "rank",
        "rank_of",
        "tie_method",
        "direction",
        "scale_min",
        "scale_max",
        "unit"
      ],
      "title": "MetricRanking",
      "type": "object"
    },
