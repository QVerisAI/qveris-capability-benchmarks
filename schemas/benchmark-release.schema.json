{
  "$defs": {
    "DetailScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "DetailValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/DetailScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/DetailValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/DetailValue"
          },
          "propertyNames": {
            "$ref": "#/$defs/MetricDetailKey"
          },
          "type": "object"
        }
      ]
    },
    "DimensionState": {
      "enum": [
        "measured",
        "declared",
        "evidence_insufficient"
      ],
      "title": "DimensionState",
      "type": "string"
    },
    "MetricDefinition": {
      "additionalProperties": false,
      "properties": {
        "cap_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Cap Id",
          "type": "string"
        },
        "cap_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Cap Version",
          "type": "string"
        },
        "definition_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Definition Id",
          "type": "string"
        },
        "dimension_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Dimension Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ],
          "title": "Direction",
          "type": "string"
        },
        "method_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Method Digest",
          "type": "string"
        },
        "method_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Method Version",
          "type": "string"
        },
        "metric_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Metric Id",
          "type": "string"
        },
        "scale_max": {
          "title": "Scale Max",
          "type": "number"
        },
        "scale_min": {
          "title": "Scale Min",
          "type": "number"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "definition_id",
        "cap_id",
        "cap_version",
        "metric_id",
        "dimension_id",
        "method_version",
        "method_digest",
        "scale_min",
        "scale_max",
        "unit",
        "direction"
      ],
      "title": "MetricDefinition",
      "type": "object"
    },
    "MetricDetailKey": {
      "not": {
        "anyOf": [
          {
            "pattern": "[sS][cC][oO][rR][eE]"
          },
          {
            "pattern": "[rR][aA][tT][iI][nN][gG]"
          },
          {
            "pattern": "[rR][aA][nN][kK]"
          }
        ]
      },
      "type": "string"
    },
    "MetricDetails": {
      "additionalProperties": {
        "$ref": "#/$defs/DetailValue"
      },
      "propertyNames": {
        "$ref": "#/$defs/MetricDetailKey"
      },
      "type": "object"
    },
