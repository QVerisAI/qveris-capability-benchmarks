{
  "$defs": {
    "DimensionState": {
      "enum": [
        "measured",
        "declared",
        "evidence_insufficient"
      ],
      "title": "DimensionState",
      "type": "string"
    },
    "ProfileDimension": {
      "additionalProperties": false,
      "properties": {
        "cap_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Cap Id",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "dimension_state": {
          "$ref": "#/$defs/DimensionState"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "cap_id",
        "dimension",
        "dimension_state"
      ],
      "title": "ProfileDimension",
      "type": "object"
    },
    "ScenarioRef": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "version"
      ],
      "title": "ScenarioRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cap_dimensions": {
      "items": {
        "$ref": "#/$defs/ProfileDimension"
      },
      "minItems": 1,
      "title": "Cap Dimensions",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "scenario_ref": {
      "$ref": "#/$defs/ScenarioRef"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "version",
    "scenario_ref",
    "cap_dimensions"
  ],
  "title": "TaskFitProfile",
  "type": "object"
}
