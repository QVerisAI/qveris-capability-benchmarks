{
  "$defs": {
    "DetailScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "DetailValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/DetailScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/DetailValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/DetailValue"
          },
          "propertyNames": {
            "$ref": "#/$defs/MetricDetailKey"
          },
          "type": "object"
        }
      ]
    },
    "DimensionState": {
      "enum": [
        "measured",
        "declared",
        "evidence_insufficient"
      ],
      "title": "DimensionState",
      "type": "string"
    },
    "MetricDetailKey": {
      "not": {
        "anyOf": [
          {
            "pattern": "[sS][cC][oO][rR][eE]"
          },
          {
            "pattern": "[rR][aA][tT][iI][nN][gG]"
          },
          {
            "pattern": "[rR][aA][nN][kK]"
          }
        ]
      },
      "type": "string"
    },
    "MetricDetails": {
      "additionalProperties": {
        "$ref": "#/$defs/DetailValue"
      },
      "propertyNames": {
        "$ref": "#/$defs/MetricDetailKey"
      },
      "type": "object"
    },
    "MetricRanking": {
      "additionalProperties": false,
      "properties": {
        "access_path_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Access Path Id",
          "type": "string"
        },
        "cap_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Cap Id",
          "type": "string"
        },
        "cap_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Cap Version",
          "type": "string"
        },
        "cohort_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Cohort Digest",
          "type": "string"
        },
        "cohort_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Cohort Id",
          "type": "string"
        },
        "definition_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Definition Digest",
          "type": "string"
        },
        "dimension_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Dimension Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ],
          "title": "Direction",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "method_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Method Digest",
          "type": "string"
        },
        "method_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Method Version",
          "type": "string"
        },
        "metric_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Metric Id",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Provider Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "rank_of": {
          "minimum": 1,
          "title": "Rank Of",
          "type": "integer"
        },
        "scale_max": {
          "title": "Scale Max",
          "type": "number"
        },
        "scale_min": {
          "title": "Scale Min",
          "type": "number"
        },
        "suite_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Suite Fingerprint",
          "type": "string"
        },
        "tie_method": {
          "enum": [
            "competition",
            "dense",
            "ordinal"
          ],
          "title": "Tie Method",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "definition_digest",
        "dimension_id",
        "cap_id",
        "cap_version",
        "provider_id",
        "access_path_id",
        "method_version",
        "method_digest",
        "suite_fingerprint",
        "evidence_refs",
        "cohort_id",
        "cohort_digest",
        "rank",
        "rank_of",
        "tie_method",
        "direction",
        "scale_min",
        "scale_max",
        "unit"
      ],
      "title": "MetricRanking",
      "type": "object"
    },
    "MetricScore": {
      "additionalProperties": false,
      "properties": {
        "access_path_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Access Path Id",
          "type": "string"
        },
        "cap_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Cap Id",
          "type": "string"
        },
        "cap_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Cap Version",
          "type": "string"
        },
        "definition_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Definition Digest",
          "type": "string"
        },
        "dimension_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Dimension Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ],
          "title": "Direction",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "method_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Method Digest",
          "type": "string"
        },
        "method_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Method Version",
          "type": "string"
        },
        "metric_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Metric Id",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Provider Id",
          "type": "string"
        },
        "scale_max": {
          "title": "Scale Max",
          "type": "number"
        },
        "scale_min": {
          "title": "Scale Min",
          "type": "number"
        },
        "suite_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Suite Fingerprint",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric_id",
        "definition_digest",
        "dimension_id",
        "cap_id",
        "cap_version",
        "provider_id",
        "access_path_id",
        "method_version",
        "method_digest",
        "suite_fingerprint",
        "evidence_refs",
        "value",
        "scale_min",
        "scale_max",
        "unit",
        "direction"
      ],
      "title": "MetricScore",
      "type": "object"
    },
    "ProfileDimension": {
      "additionalProperties": false,
      "properties": {
        "cap_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Cap Id",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/MetricDetails",
          "propertyNames": {
            "not": {
              "anyOf": [
                {
                  "pattern": "[sS][cC][oO][rR][eE]"
                },
                {
                  "pattern": "[rR][aA][tT][iI][nN][gG]"
                },
                {
                  "pattern": "[rR][aA][nN][kK]"
                }
              ]
            }
          }
        },
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "dimension_state": {
          "$ref": "#/$defs/DimensionState"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "metric_ranking": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricRanking"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metric_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "cap_id",
        "dimension",
        "dimension_state"
      ],
      "title": "ProfileDimension",
      "type": "object"
    },
    "ScenarioRef": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "version"
      ],
      "title": "ScenarioRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cap_dimensions": {
      "items": {
        "$ref": "#/$defs/ProfileDimension"
      },
      "minItems": 1,
      "title": "Cap Dimensions",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "scenario_ref": {
      "$ref": "#/$defs/ScenarioRef"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "version",
    "scenario_ref",
    "cap_dimensions"
  ],
  "title": "TaskFitProfile",
  "type": "object"
}
