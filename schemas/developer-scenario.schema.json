{
  "$defs": {
    "ScenarioCapabilityRequirement": {
      "additionalProperties": false,
      "properties": {
        "cap_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Cap Id",
          "type": "string"
        },
        "minimum_question_roles": {
          "items": {
            "enum": [
              "core_positive",
              "boundary_negative",
              "coverage",
              "freshness_precision",
              "shape_completeness",
              "agent_contract"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Minimum Question Roles",
          "type": "array"
        },
        "priority": {
          "enum": [
            "p0",
            "p1",
            "p2"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "cap_id",
        "priority",
        "minimum_question_roles"
      ],
      "title": "ScenarioCapabilityRequirement",
      "type": "object"
    },
    "ScenarioCompletionPolicy": {
      "additionalProperties": false,
      "properties": {
        "missing_dimension_state": {
          "const": "evidence_insufficient",
          "title": "Missing Dimension State",
          "type": "string"
        },
        "required_priorities": {
          "items": {
            "enum": [
              "p0",
              "p1",
              "p2"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Priorities",
          "type": "array"
        },
        "required_release_state": {
          "const": "verified",
          "title": "Required Release State",
          "type": "string"
        }
      },
      "required": [
        "required_priorities",
        "required_release_state",
        "missing_dimension_state"
      ],
      "title": "ScenarioCompletionPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completion_policy": {
      "$ref": "#/$defs/ScenarioCompletionPolicy"
    },
    "developer_decision": {
      "minLength": 10,
      "title": "Developer Decision",
      "type": "string"
    },
    "languages": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Languages",
      "type": "array"
    },
    "markets": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Markets",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "required_capabilities": {
      "items": {
        "$ref": "#/$defs/ScenarioCapabilityRequirement"
      },
      "minItems": 1,
      "title": "Required Capabilities",
      "type": "array"
    },
    "review_status": {
      "const": "approved",
      "title": "Review Status",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "target_users": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Target Users",
      "type": "array"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "version",
    "name",
    "developer_decision",
    "target_users",
    "markets",
    "languages",
    "required_capabilities",
    "completion_policy",
    "source_ids",
    "review_status"
  ],
  "title": "DeveloperScenario",
  "type": "object"
}
