{
  "$defs": {
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "catalog_snapshot_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Catalog Snapshot Digest",
          "type": "string"
        },
        "contract_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Digest",
          "type": "string"
        },
        "contract_version": {
          "minimum": 1,
          "title": "Contract Version",
          "type": "integer"
        },
        "harbor_capability_id": {
          "minLength": 3,
          "pattern": "^[A-Z][A-Z0-9]*(?:\\.[A-Z][A-Z0-9_]*)+$",
          "title": "Harbor Capability Id",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        }
      },
      "required": [
        "source_type",
        "harbor_capability_id",
        "contract_version",
        "catalog_snapshot_digest",
        "contract_digest"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "harbor_catalog"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_types": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Asset Types",
      "type": "array"
    },
    "business_use": {
      "minLength": 10,
      "title": "Business Use",
      "type": "string"
    },
    "cap_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Cap Id",
      "type": "string"
    },
    "exclusions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "markets": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Markets",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Scope",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "cap_id",
    "version",
    "name",
    "business_use",
    "scope",
    "sources"
  ],
  "title": "CapDefinition",
  "type": "object"
}
