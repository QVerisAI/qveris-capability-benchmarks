{
  "$defs": {
    "AccessPathType": {
      "enum": [
        "native_mcp",
        "official_openapi",
        "official_api",
        "official_sdk",
        "benchmark_wrapper",
        "qveris_connector"
      ],
      "title": "AccessPathType",
      "type": "string"
    },
    "AccessProtocol": {
      "enum": [
        "https_rest",
        "mcp_streamable_http",
        "mcp_sse",
        "fix_44",
        "sdk"
      ],
      "title": "AccessProtocol",
      "type": "string"
    },
    "QualificationDecision": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "$ref": "#/$defs/QualificationDisposition"
        },
        "evidence_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "reason": {
          "minLength": 10,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "disposition",
        "reason",
        "evidence_digest"
      ],
      "title": "QualificationDecision",
      "type": "object"
    },
    "QualificationDisposition": {
      "enum": [
        "included",
        "excluded"
      ],
      "title": "QualificationDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "access_path_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Access Path Id",
      "type": "string"
    },
    "agent_trial_eligible": {
      "title": "Agent Trial Eligible",
      "type": "boolean"
    },
    "authentication": {
      "minLength": 1,
      "title": "Authentication",
      "type": "string"
    },
    "authorization": {
      "minLength": 1,
      "title": "Authorization",
      "type": "string"
    },
    "canonical_interface": {
      "minLength": 1,
      "title": "Canonical Interface",
      "type": "string"
    },
    "endpoint_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Endpoint Url"
    },
    "official_source": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Official Source",
      "type": "string"
    },
    "path_type": {
      "$ref": "#/$defs/AccessPathType"
    },
    "plan_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Name"
    },
    "protocol": {
      "$ref": "#/$defs/AccessProtocol"
    },
    "provider_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Provider Id",
      "type": "string"
    },
    "qualification": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualificationDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "access_path_id",
    "provider_id",
    "path_type",
    "official_source",
    "authorization",
    "canonical_interface",
    "protocol",
    "endpoint_url",
    "authentication",
    "agent_trial_eligible"
  ],
  "title": "AccessPath",
  "type": "object"
}
